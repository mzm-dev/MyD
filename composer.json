{
    "name": "mzm/mydigitalid",
    "description": "MyDigital ID (MIMOS/Keycloak OpenID Connect) SSO login integration for Laravel applications.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mzm\\MyDigitalId\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mzm\\MyDigitalId\\MyDigitalIdServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
     "prefer-stable": true
}
